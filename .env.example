# ============================================================
# AdGuard Home + Tailscale + Macvlan Configuration
# ============================================================

# Tailscale Auth Key (Required for initial container setup)
# Generate key at: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-xxxx-xxxx

# Tailscale Hostname in Tailnet
TS_HOSTNAME=adguard-home

# Timezone
TZ=Asia/Tokyo

# Tailnet Devices Sync Interval in seconds (Default: 3600 seconds = 1 hour)
SYNC_INTERVAL=3600

# ============================================================
# Macvlan Network Settings
# (Can be auto-generated by running `./setup.sh`)
# ============================================================

# Host network interface (e.g., eth0, enp3s0, wlan0)
MACVLAN_PARENT=eth0

# Subnet of your local network
MACVLAN_SUBNET=192.168.1.0/24

# Gateway IP of your local router
MACVLAN_GATEWAY=192.168.1.1

# IP Allocation Mode:
# 1. DHCP / Auto IP Allocation: Leave MACVLAN_IP empty (MACVLAN_IP=)
# 2. Static IP Assignment: Specify target IP (e.g., MACVLAN_IP=192.168.1.250)
MACVLAN_IP=192.168.1.250
